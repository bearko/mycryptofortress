{
  "name": "mycryptofortress-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Outhold-style tower defense x incremental game using MCH assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:sync:remote": "node scripts/sync-assets.mjs --remote",
    "assets:check": "node scripts/sync-assets.mjs --check"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
